        {
          "origin": "ledger",
          "text": "Done at the City of Washington, this first day of January, in the year of our Lord one thousand eight hundred and sixty three, and of the Independence of the United States of America the eighty-seventh.",
          "page": "ORIGINAL-0003",
          "source_id": "ORIGINAL-0003",
          "answer_supported": false,
          "source_support_established": false,
          "hash": "sha256:0b85c918a8ebb763e38521d95e79e8d65d80d3c5d2667c14d2992a8d13e92b69",
