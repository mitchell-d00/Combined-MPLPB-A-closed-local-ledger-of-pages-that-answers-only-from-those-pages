        },
        {
          "origin": "ledger",
          "text": "I have full confidence in your courage, devotion to duty and skill in battle. We will accept nothing less than full Victory!",
          "page": "ORIGINAL-0001",
          "source_id": "ORIGINAL-0001",
          "answer_supported": false,
          "source_support_established": false,
          "hash": "sha256:93d03d3493443fc88a7926765b45deac1cfc15592e9bf03cc27b5a2c737fe124",
          "path": "original-0001.html",
