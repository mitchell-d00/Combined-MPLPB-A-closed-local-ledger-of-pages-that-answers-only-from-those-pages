          "source_id": "ORIGINAL-0001",
          "path": "original-0001.html",
          "hash": "sha256:93d03d3493443fc88a7926765b45deac1cfc15592e9bf03cc27b5a2c737fe124",
          "body_start": 354,
          "text": "Citation: D-day statement to soldiers, sailors, and airmen of the Allied Expeditionary Force, 6/44, Collection DDE-EPRE: Eisenhower, Dwight D: Papers, Pre-Presidential, 1916-1952; Dwight D. Eisenhower Library; National Archives and Records Administration.",
          "body_projection": "body-text-no-headings-v1",
          "context_truncated": false,
