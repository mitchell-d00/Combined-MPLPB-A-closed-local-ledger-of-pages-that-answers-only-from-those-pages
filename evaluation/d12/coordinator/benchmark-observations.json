          "citations": [
            {
              "body_end": 7123,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 6904,
              "end": 7123,
              "hash": "sha256:e3ec7774d22142e5251f1650d4fe1faa1e11c125c274e8a4c982d18b23714c8f",
              "path": "original-0007.html",
              "quote": "The Apollo 13 mission, planned as a lunar landing in the Fra Mauro\narea, was aborted because of an abrupt loss of service module cryogenic\noxygen associated with a fire in one of the two tanks at approximately\n56 hours.",
              "source_id": "ORIGINAL-0007",
              "start": 6904
            },
            {
              "body_end": 7242,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 7124,
              "end": 7242,
              "hash": "sha256:e3ec7774d22142e5251f1650d4fe1faa1e11c125c274e8a4c982d18b23714c8f",
              "path": "original-0007.html",
              "quote": "The lunar module provided the necessary support to sustain a\nminimum operational\ncondition for a safe return to earth.",
              "source_id": "ORIGINAL-0007",
              "start": 7124
            }
          ]
        },
        {
          "id": "U01",
          "diagnostic": "partial_documentary_evidence",
          "passage_anchors": 0,
          "graph_anchors": 0,
          "citations": [
            {
              "body_end": 2042,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 1940,
              "end": 2042,
              "hash": "sha256:93d03d3493443fc88a7926765b45deac1cfc15592e9bf03cc27b5a2c737fe124",
              "path": "original-0001.html",
              "quote": "Shortly after the conference ended, Roosevelt appointed Gen. Dwight David Eisenhower to that position.",
              "source_id": "ORIGINAL-0001",
              "start": 1940
            },
            {
              "body_end": 2042,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 1522,
              "end": 2042,
              "hash": "sha256:93d03d3493443fc88a7926765b45deac1cfc15592e9bf03cc27b5a2c737fe124",
              "path": "original-0001.html",
              "quote": "Churchill and Roosevelt told Stalin that the invasion “would be possible” by August 1, 1944, but that no decision had yet been made to name a supreme commander. To this latter point, Stalin pointedly rejoined, “Then nothing will come of these operations. Who carries the moral and technical responsibility for this operation?” Churchill and Roosevelt acknowledged the need to name the commander without further delay. Shortly after the conference ended, Roosevelt appointed Gen. Dwight David Eisenhower to that position.",
              "source_id": "ORIGINAL-0001",
              "start": 1522
            }
          ]
        },
        {
          "id": "U06",
          "diagnostic": "partial_documentary_evidence",
          "passage_anchors": 0,
          "graph_anchors": 0,
          "citations": [
            {
              "body_end": 4588,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 4545,
              "end": 4588,
              "hash": "sha256:2b2900e5cc6ad6fbcf9027310ff7ea41568a67df84a51a8f72352e1945ef85a4",
              "path": "original-0002.html",
              "quote": "Ferdinand Hayden surveyed the area in 1871.",
              "source_id": "ORIGINAL-0002",
              "start": 4545
            },
            {
              "body_end": 5254,
              "body_projection": "body-text-no-headings-v1",
              "body_start": 4545,
              "end": 5254,
              "hash": "sha256:2b2900e5cc6ad6fbcf9027310ff7ea41568a67df84a51a8f72352e1945ef85a4",
              "path": "original-0002.html",
              "quote": "Ferdinand Hayden surveyed the area in 1871. Upon his return to the East, he mounted a campaign to promote, but also to protect, the natural wonders he had seen. He quickly wrote a well-received article for Scribner’s Monthly that included fellow expedition member Thomas Moran’s illustrations. He provided Charles Bierstadt, brother to the artist and a leading manufacturer of stereographic cards, with copies of William Jackson’s expedition photographs. He lobbied members of Congress by presenting them with an album of Jackson’s Yellowstone photographs. He was supported in his effort by Jay Cooke, the railroad magnate who anticipated increased tourist ridership on his lines serving the Yellowstone area.",
              "source_id": "ORIGINAL-0002",
              "start": 4545
            }
          ]
        }
