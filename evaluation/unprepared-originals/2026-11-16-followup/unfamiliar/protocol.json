{
  "schema": "unfamiliar-relational-protocol-v1",
  "outcome_scope": "Actual source-linked candidate interpretations assessed against finite developer reference facets. Not independent historical accuracy.",
  "max_seconds_per_question": 180,
  "native_supported_answer_not_required": true,
  "human_independent_evaluation": "NOT RUN",
  "criteria": [
    "actor/action separation",
    "conditional versus occurred",
    "date-role separation",
    "scope/negation preserved",
    "quotation versus issuance",
    "framing versus original text",
    "permission versus obligation",
    "causality requires explicit evidence"
  ],
  "reference_completeness": false,
  "metrics": [
    "retrieval draft coverage",
    "developer-assessed correct/incorrect/unresolved candidate relationships",
    "missed finite reference facets",
    "source citation fidelity",
    "justified refusal against scoped negatives",
    "CPU/wall/RSS/logical reads",
    "authority regressions"
  ],
  "reference_and_all_outputs_preserved": true
}
