{
  "protocol": "mplpb-agent-handshake",
  "version": "1.0",
  "name": "Combined MPLPB browser middleware",
  "repository": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages",
  "site": "https://mitchell-d00.github.io/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/",
  "discovery": {
    "manifest": ".well-known/mplpb.json",
    "agent_notes": "llms.txt",
    "public_ledger": "mplpb-public-ledger.json",
    "instructions": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/AGENT_MIDDLEWARE.md",
    "browser_testing": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/BROWSER_TESTING_FOR_AGENTS.md",
    "local_mcp": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/MCP_AGENT.md",
    "browser_helper": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/FREE_PUBLIC_HELPER.md",
    "package_guide": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/PACKAGE_GUIDE.md",
    "sorter_guide": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/PREPROCESSING_SORTER.md",
    "documentation_index": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/README.md",
    "team_building_guide": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/TEAMBUILDING.md"
  },
  "runtime": {
    "engine": "full Python MPLPB via browser WebAssembly",
    "python_server_required": false,
    "remote_http_query": false,
    "transport": "execute window.MPLPB in the running app page",
    "local_storage": "per-browser IndexedDB"
  },
  "methods": {
    "handshake": "window.MPLPB.handshake()",
    "strict_query": "window.MPLPB.relay(question,{corpus})",
    "page_retrieval": "window.MPLPB.retrieve(question,{corpus,profile})",
    "session_chat": "window.MPLPB.relay(message,{corpus,mode:'chat',session})",
    "list_pages": "window.MPLPB.listPages({corpus,profile:'external'})",
    "read_page": "window.MPLPB.readPage(path,{corpus,profile:'external'})",
    "betty": "window.MPLPB.betty()",
    "al": "window.MPLPB.al()"
  },
  "policy": {
    "authority": "MPLPB reader or chat engine",
    "verbatim_reply": true,
    "unrequested_ai_suggestions": false,
    "suggestions_opt_in": "includeSuggestions:true",
    "default_network": false,
    "allow_network_opt_in": "allowNetwork:true per chat call",
    "preserve_ambiguity_and_refusal": true
  },
  "privacy": {
    "snapshot": "build-time externally eligible bundled pages only",
    "visitor_ledger_shared": false,
    "visitor_sessions_shared": false
  },
  "notice": "A URL advertises callable methods, not permission to read another visitor's browser storage. HTTP-only callers can read the published public snapshot, but live MPLPB calls require a running browser context.",
  "local_mcp": {
    "transport": "stdio",
    "launcher": "tools/mplpb_mcp.py",
    "protocol_version": "2025-06-18",
    "source_checkout_required": true,
    "remote_http_endpoint": false,
    "configuration": "host-authorized collection keys/paths and fixed delivery profile",
    "shares_browser_indexeddb": false
  },
  "browser_helper": {
    "entry": "same published browser page",
    "model_loading": "explicit opt-in; compatible visitor WebGPU device required",
    "source_writes": "human-reviewed create/import through the existing page API",
    "paid_inference_backend": false,
    "model_training": false,
    "visitor_storage_shared": false,
    "remote_mcp_endpoint": false
  },
  "team_building": {
    "schema": "mplpb-teambuilding-v1",
    "guide": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/docs/TEAMBUILDING.md",
    "repository_handoff": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/HANDOFF.md#betty-report-for-al",
    "pull_requests": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/pulls",
