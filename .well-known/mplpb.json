    "repository_review": "https://github.com/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/blob/main/README.md#directions-for-an-ai-to-inspect-the-full-combined-mplpb-package",
    "relay": {
      "betty_calls_al": "Start Betty first. Betty leaves a current report for Al on every push and in the relevant PR. Then open a separate Al chat with the repository link and role name.",
      "al_calls_betty": "Al reads the repository and Betty’s live PR report, judges the results against the evidence, and drafts the next prompt for Betty.",
      "maintainer_relays": "The maintainer copies Al’s response from the separate Al chat and pastes it with their own direction into Betty’s chat.",
      "betty_updates_pr": "Betty runs the authorized tests and updates the same live PR report with the current head, last applied change, measured results, shareable advice, maintainer direction and next step. Commit the current handoff with every push."
    },
    "start_order": [
      "betty",
      "al"
    ],
    "resume": {
      "live_pull_requests_api": "https://api.github.com/repos/mitchell-d00/Combined-MPLPB-A-closed-local-ledger-of-pages-that-answers-only-from-those-pages/pulls?state=open&sort=updated&direction=desc",
      "report_contract": "The live PR carries Betty’s latest applied state for that track. Update its current report after each push, test run or maintainer decision.",
      "fields": [
        "current PR head",
        "last change applied",
        "measured checks and outcomes",
        "pending or open work",
        "next authorized step",
        "archive recovery when applicable"
      ],
      "verify": "Read the live PR before resuming. Compare the report’s pin with head.sha. If they differ, use HANDOFF.md at the current head to reconcile the report before relying on it.",
      "terminal": "Give either role command the live GitHub PR URL to return its current state and a handoff link pinned to its head."
